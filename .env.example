BOT_TOKEN=your_telegram_bot_token_here
DOWNLOAD_DIR=/tmp/kinescope_downloads
MAX_FILE_SIZE_MB=2000
ALLOWED_USER_IDS=123456789,987654321
# Cooldown between requests per user in seconds (default: 30)
RATE_LIMIT_SECONDS=30
# Max simultaneous downloads per user (default: 1)
MAX_CONCURRENT_PER_USER=1
# Path to Netscape-format cookies file for Instagram authentication (optional)
# Export from browser using "Get cookies.txt" extension, then set the path here
INSTAGRAM_COOKIES_FILE=/path/to/instagram_cookies.txt
